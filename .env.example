# ==========================================
# DISCORD CONFIGURATION
# ==========================================
# Obtain your Bot Token from Discord Developer Portal -> Bot -> Reset Token
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Channel ID where guild logs should be sent (Right-click channel in Discord -> Copy Channel ID)
DISCORD_CHANNEL_ID=123456789012345678

# Optional: Webhook URL fallback if you prefer webhooks
DISCORD_WEBHOOK_URL=

# ==========================================
# FREE FIRE CONFIGURATION
# ==========================================
# Target Guild ID
FF_GUILD_ID=123456789

# Region: IND (India), BR (Brazil), US (North America), SG (Singapore), EU (Europe), etc.
FF_REGION=IND

# ALT / DUMMY ACCOUNT CREDENTIALS (NEVER USE YOUR MAIN ACCOUNT!)
FF_BOT_UID=
FF_ACCESS_TOKEN=

# Unofficial API Gateway or TCP proxy endpoint (if using a gateway service)
FF_API_GATEWAY_URL=http://localhost:8080
FF_API_KEY=your_api_gateway_key_here

# ==========================================
# BOT BEHAVIOR
# ==========================================
# Interval in seconds to poll for updates (recommended: 30 to 60)
POLL_INTERVAL_SECONDS=30

# Set to true to run in Simulation / Mock Mode for testing without active Free Fire token
MOCK_MODE=true
