# ====================================================================
# 1. DISCORD SETTINGS (REQUIRED)
# ====================================================================
# Paste your Discord Webhook URL below:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token

# (Optional: Discord Bot Token & Channel ID if running discord_bot.py instead of webhook)
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=0

# ====================================================================
# 2. FREE FIRE GUILD SETTINGS
# ====================================================================
# Your Free Fire Guild ID (e.g. 123456789)
FF_GUILD_ID=123456789

# Your game region (IND = India, BR = Brazil, US = North America, SG = Singapore, EU = Europe)
FF_REGION=IND

# ====================================================================
# 3. ADVANCED GAME CONNECTION (LEAVE BLANK IF YOU DON'T HAVE THEM!)
# ====================================================================
# Since Garena does not give official API keys, leave these blank.
# The bot runs in MOCK_MODE=true by default to test all Discord alerts.
FF_BOT_UID=
FF_ACCESS_TOKEN=
FF_API_GATEWAY_URL=
FF_API_KEY=

# ====================================================================
# 4. BOT BEHAVIOR
# ====================================================================
# Leave MOCK_MODE=true to test your Discord Webhook logs immediately
MOCK_MODE=true

# How often to check for updates (in seconds)
POLL_INTERVAL_SECONDS=30
